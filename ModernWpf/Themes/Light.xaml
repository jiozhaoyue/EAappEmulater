<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 基础背景与前景 -->
    <Color x:Key="ThemeBackgroundColor">#FDFDFD</Color>
    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="{StaticResource ThemeBackgroundColor}" />

    <Color x:Key="ThemeCaptionBackgroundColor">#FAFAFA</Color>
    <SolidColorBrush x:Key="ThemeCaptionBackgroundBrush" Color="{StaticResource ThemeCaptionBackgroundColor}" />

    <Color x:Key="ThemeSidebarBackgroundColor">#FAFAFA</Color>
    <SolidColorBrush x:Key="ThemeSidebarBackgroundBrush" Color="{StaticResource ThemeSidebarBackgroundColor}" />

    <Color x:Key="ThemeCardBackgroundColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="{StaticResource ThemeCardBackgroundColor}" />

    <Color x:Key="ThemeControlBackgroundColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="ThemeControlBackgroundBrush" Color="{StaticResource ThemeControlBackgroundColor}" />

    <Color x:Key="ThemeForegroundColor">#000000</Color>
    <SolidColorBrush x:Key="ThemeForegroundBrush" Color="{StaticResource ThemeForegroundColor}" />

    <Color x:Key="ThemeSecondaryForegroundColor">#666666</Color>
    <SolidColorBrush x:Key="ThemeSecondaryForegroundBrush" Color="{StaticResource ThemeSecondaryForegroundColor}" />

    <!-- 边框与分割线 -->
    <Color x:Key="ThemeBorderColor">#E5E5E5</Color>
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="{StaticResource ThemeBorderColor}" />

    <Color x:Key="ThemeWindowBorderColor">#4F4D4B</Color>
    <SolidColorBrush x:Key="ThemeWindowBorderBrush" Color="{StaticResource ThemeWindowBorderColor}" />

    <Color x:Key="ThemeCardBorderColor">#BBBBBB</Color>
    <SolidColorBrush x:Key="ThemeCardBorderBrush" Color="{StaticResource ThemeCardBorderColor}" />

    <Color x:Key="ThemeSeparatorColor">#DADADA</Color>
    <SolidColorBrush x:Key="ThemeSeparatorBrush" Color="{StaticResource ThemeSeparatorColor}" />

    <!-- 交互状态：悬停与选中 -->
    <Color x:Key="ThemeHoverBackgroundColor">#F1F1F1</Color>
    <SolidColorBrush x:Key="ThemeHoverBackgroundBrush" Color="{StaticResource ThemeHoverBackgroundColor}" />

    <Color x:Key="ThemeSelectedBackgroundColor">#E6E6E6</Color>
    <SolidColorBrush x:Key="ThemeSelectedBackgroundBrush" Color="{StaticResource ThemeSelectedBackgroundColor}" />

    <!-- 窗口控制按钮 -->
    <Color x:Key="ThemeWinButtonOverBackgroundColor">#DBDBDB</Color>
    <SolidColorBrush x:Key="ThemeWinButtonOverBackgroundBrush" Color="{StaticResource ThemeWinButtonOverBackgroundColor}" />

    <Color x:Key="ThemeWinButtonPressedBackgroundColor">#C2C2C2</Color>
    <SolidColorBrush x:Key="ThemeWinButtonPressedBackgroundBrush" Color="{StaticResource ThemeWinButtonPressedBackgroundColor}" />

    <Color x:Key="ThemeWinButtonForegroundColor">#000000</Color>
    <SolidColorBrush x:Key="ThemeWinButtonForegroundBrush" Color="{StaticResource ThemeWinButtonForegroundColor}" />

    <!-- 右键菜单 -->
    <Color x:Key="ThemeContextMenuBackgroundColor">#FAFAFA</Color>
    <SolidColorBrush x:Key="ThemeContextMenuBackgroundBrush" Color="{StaticResource ThemeContextMenuBackgroundColor}" />

    <Color x:Key="ThemeContextMenuBorderColor">#4F4D4B</Color>
    <SolidColorBrush x:Key="ThemeContextMenuBorderBrush" Color="{StaticResource ThemeContextMenuBorderColor}" />

</ResourceDictionary>
